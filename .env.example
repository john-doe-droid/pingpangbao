# ============================================================================
# 环境变量样例文件
#
# 用法：把本文件复制为 .env，然后按下面的说明填写。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Windows CMD:         copy .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，**不要**提交到仓库。
# ⚠️ 本文件里的值都是示例，不是可用密钥。
# ============================================================================

# ---------------------------------------------------------------------------
# Django 基础
# ---------------------------------------------------------------------------
# 选择配置：本地开发用 config.settings.dev，正式部署用 config.settings.prod
# （manage.py 未设置时默认 dev；Docker/生产脚本会显式设为 prod）
DJANGO_SETTINGS_MODULE=config.settings.dev

# 开关 DEBUG。注意：prod 配置中 DEBUG 恒为 False，此项在生产不生效。
DJANGO_DEBUG=true

# 生产环境必须提供，且长度 >= 40、不能是占位值。
# 生成方法（复制整行到终端执行）：
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 允许访问的域名/IP，逗号分隔。生产环境**必填**，留空会直接启动失败。
# 例：DJANGO_ALLOWED_HOSTS=stat.example.com,www.stat.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 生产域名（裸域名，不带 https:// 或路径）。Nginx 模板和证书路径都使用它。
# DOMAIN=stat.example.com

# CSRF 可信来源，逗号分隔，必须带协议前缀。生产环境**必填**。
# 例：DJANGO_CSRF_TRUSTED_ORIGINS=https://stat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------------------------------------------------------------------------
# 数据库（PostgreSQL —— 本项目的唯一数据库）
# ---------------------------------------------------------------------------
POSTGRES_DB=pingpong_dev
POSTGRES_USER=pingpong
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 生产环境额外项（本地开发可留空）
# POSTGRES_CONN_MAX_AGE=60
# POSTGRES_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# HTTPS / 安全（仅生产相关）
# ---------------------------------------------------------------------------
# 正式对外服务时保持 true。仅在本机验证生产配置时可临时设为 false。
DJANGO_HTTPS_ENABLED=true
# HSTS 有效期（秒），默认一年
# DJANGO_HSTS_SECONDS=31536000
# 会话有效期（秒），默认 12 小时
# DJANGO_SESSION_COOKIE_AGE=43200

# ---------------------------------------------------------------------------
# 站点信息
# ---------------------------------------------------------------------------
SITE_NAME=中国农业大学乒乓球社工作统计

# 登录失败限流（按账号 + 来源 IP）
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCK_SECONDS=300
# 仅在反向代理会覆盖 X-Real-IP / X-Forwarded-For 时开启。
# Docker Compose 已在 app 服务中显式开启。
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# P3：上传与配额上限（不填则使用代码中的默认值）
# ---------------------------------------------------------------------------
# 单文件输入上限（字节）。默认：图片 10 MiB / 文件 50 MiB
# UPLOAD_IMAGE_MAX_BYTES=10485760
# UPLOAD_FILE_MAX_BYTES=52428800

# 个人图片配额（每学期）。3–8 月为春季学期，9 月至次年 2 月为秋季学期。
# 默认：每学期 50 张 / 100 MiB
# UPLOAD_IMAGES_PER_USER=50
# UPLOAD_IMAGE_BYTES_PER_USER=104857600

# 图片处理参数（默认与需求一致，一般不用改）
# UPLOAD_IMAGE_MAX_EDGE=1280
# UPLOAD_IMAGE_QUALITY=82
# UPLOAD_THUMB_EDGE=400
# UPLOAD_THUMB_QUALITY=78

# 单次提交数量与总量限制
# UPLOAD_IMAGES_PER_SUBMISSION=20
# UPLOAD_FILES_PER_SUBMISSION=5
# UPLOAD_SUBMISSION_TOTAL_BYTES=104857600

# 文字与审核意见长度上限
# UPLOAD_TEXT_MAX_CHARS=20000
# UPLOAD_COMMENT_MAX_CHARS=5000

# 预签名下载链接有效期（秒），默认 5 分钟
# COS_PRESIGN_EXPIRES=300

# ---------------------------------------------------------------------------
# P3 / P5：私有附件存储
# ---------------------------------------------------------------------------
# P5 起生产默认走**服务器本地磁盘**（附件存在持久化数据目录里，不依赖云存储）。
#   local —— 服务器本地磁盘（推荐，默认）
#   cos   —— 腾讯云 COS 私有对象存储（可选，适合日后扩容/多机）
# 生产环境**必须显式配置**本项：不配会直接报错，避免"忘了配"导致附件
# 被写进容器临时层、容器重建即丢。
PRIVATE_STORAGE_BACKEND=local

# 本地私有附件目录。**生产环境必须显式配置**，且必须位于持久化磁盘上。
# 不要放在 static/ 或 media/ 之下（会被反向代理直接服务，绕过鉴权）。
#   Linux 服务器：/srv/pingpong-data/private_media
#   Windows 本地：E:/乒乓数据/private_media
# PRIVATE_MEDIA_ROOT=

# --- 宿主机数据目录（docker compose 使用）---
# 数据库与附件都放在这个目录下，备份/迁移只需处理它。
#   Linux 服务器：PINGPONG_DATA_DIR=/srv/pingpong-data
#   Windows 本地：PINGPONG_DATA_DIR=E:/乒乓数据
# 注意用正斜杠；该目录需预先创建并给 db 容器写权限（见 deploy/README）。
# PINGPONG_DATA_DIR=./data

# --- 腾讯云 COS（仅当 PRIVATE_STORAGE_BACKEND=cos 时必填）---
# 安全要求：
#   * Bucket 必须是**私有读写**（不要开公有读）；
#   * 主账号密钥权限过大，建议用子账号并只授予该 Bucket 的读写权限；
#   * 这些值只放这里，**不要写进代码或提交到仓库**。
# COS_REGION=ap-beijing
# COS_BUCKET=your-bucket-1250000000
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_SCHEME=https
